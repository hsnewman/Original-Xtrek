X		who->p_ship->s_etemp += (who->p_ship->s_speed / 2);
X	}
X	/* Add in some for each army on board. */
X	amt += ((who->p_ship->s_armies * who->p_ship->s_warpcost) / 2);
X	who->p_ship->s_etemp += (who->p_ship->s_armies / 2);
