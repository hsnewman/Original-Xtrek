Xchangedir(sp)
Xstruct player *sp;
X{
X    int ticks;
X
X	if (isGod(sp)) {
X		sp->p_ship->s_dir = sp->p_ship->s_desdir;
X		sp->p_ship->s_subdir = 0;
X		return;
